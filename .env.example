# ---------------------------------------------------------------------------
# Anthropic / Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-5
# Reasoning effort per call: low | medium | high | xhigh | max
# Medida en este proyecto: medium y high eligen la misma fraccion y con la
# misma confianza, pero medium tarda 3-4 s menos y se mantiene bajo el
# limite de 20 s que fija el PRD.
CLAUDE_EXTRACTION_EFFORT=medium
CLAUDE_CLASSIFICATION_EFFORT=medium

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Inside docker compose the host is the service name "mongo".
MONGO_URI=mongodb://mongo:27017
MONGO_DB=tariff_assistant

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-with-a-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Single user created by the seed script (no sign-up in the MVP).
SEED_USER_EMAIL=demo@aduana.mx
SEED_USER_PASSWORD=demo1234

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads
PEDIMENTO_DIR=/data/pedimentos
CATALOG_JSON_PATH=/data/catalog/tariff_items.json
SAT_EXCEL_PATH=/data/c_FraccionArancelaria.xlsx
SNICE_EXCEL_PATH=/data/snice_aranceles.xlsx
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
# Classifications below this confidence require explicit manual confirmation.
CONFIDENCE_THRESHOLD=0.6
DEFAULT_EXCHANGE_RATE=17.50

# Mock counterparties preloaded into the operation form.
DEFAULT_ORIGIN_COUNTRY=CN
DEFAULT_IMPORTER_RFC=XAXX010101000
DEFAULT_IMPORTER_NAME=Importadora Demo SA de CV
DEFAULT_SUPPLIER_NAME=Shenzhen Electronics Co Ltd
DEFAULT_SUPPLIER_COUNTRY=CN

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
